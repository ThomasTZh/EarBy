<?xml version="1.0" encoding="utf-8"?>
<!--
    Automatic cloud backup is disabled for this app (android:allowBackup="false").
    Everything is still excluded explicitly, because some device-transfer paths consult these
    rules independently of the allowBackup flag. The product's backup mechanism is the explicit
    preset export through the document picker.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
